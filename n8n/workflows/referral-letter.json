    {
      "parameters": {
        "jsCode": "// Turn the records from the earlier steps into plain text for the AI.\nconst req = $('Referral request').first().json.body;\nconst pt = $('Get patient').first().json;\nconst enc = $('Get encounter').first().json;\nconst bundle = name => ($(name).first().json.entry || []).map(e => e.resource);\nconst text = cc => (cc && (cc.text || (cc.coding && cc.coding[0] && cc.coding[0].display))) || '';\nconst day = d => (d || '').slice(0, 10);\nconst visitClass = { AMB: 'Ambulatory visit', IMP: 'Inpatient stay', EMER: 'Emergency visit', VR: 'Virtual visit', HH: 'Home visit' };\nconst list = items => (items.length ? items.map(i => '- ' + i).join('\\n') : 'None documented.');\n\nconst n = (pt.name || [])[0] || {};\nconst name = [(n.given || []).join(' '), n.family].join(' ').trim() || 'Unknown';\nconst age = pt.birthDate ? Math.floor((Date.now() - Date.parse(pt.birthDate)) / 31557600000) : 'not documented';\n\nconst problems = [...new Set(bundle('Get problems').map(r => text(r.code)).filter(Boolean))];\nconst medications = bundle('Get medications').filter(r => r.status === 'active').map(r => {\n  const dose = ((r.dosageInstruction || [])[0] || {}).text;\n  return text(r.medicationCodeableConcept) + (dose ? ' - ' + dose : '');\n});\nconst allergies = bundle('Get allergies').map(r => {\n  const reaction = (((r.reaction || [])[0] || {}).manifestation || []).map(m => m.text).filter(Boolean).join(', ');\n  return text(r.code) + (reaction ? ' (' + reaction + ')' : '');\n});\nconst latest = {};\nfor (const o of bundle('Get labs')) {\n  const q = o.valueQuantity;\n  if (!q) continue;\n  const key = text(o.code), when = o.effectiveDateTime || '';\n  if (!latest[key] || when > latest[key].when) latest[key] = { when, v: q.value, u: q.unit };\n}\nconst results = Object.entries(latest).map(([k, l]) => `${k}: ${l.v} ${l.u} (${day(l.when)})`);\n\nconst chart = [\n  `Patient: ${name}`,\n  `${pt.gender || 'sex not documented'}, ${age} years, born ${pt.birthDate || 'not documented'}`,\n  '',\n  '== Encounter being referred from ==',\n  `Date: ${day((enc.period || {}).start) || 'not documented'}`,\n  `Type: ${((enc.type || [])[0] || {}).text || visitClass[(enc.class || {}).code] || (enc.class || {}).code || 'Encounter'}`,\n  `Reason: ${((enc.reasonCode || [])[0] || {}).text || 'not documented'}`,\n  `Status: ${enc.status || 'not documented'}`,\n  '',\n  '== Problem list ==', list(problems),\n  '',\n  '== Current medications ==', list(medications),\n  '',\n  '== Allergies ==', list(allergies),\n  '',\n  '== Results (latest of each test) ==', list(results),\n].join('\\n');\n\nconst input = `CHART:\\n${chart}\\n\\nREFERRAL REQUEST\\nSpecialty: ${req.specialty || 'not given'}\\nUrgency: ${req.urgency || 'Routine'}\\nClinician's reason for referral: ${req.reason || 'Not provided. Say what the encounter shows and that no reason was given.'}`;\nconst instructions = \"You are an assistant helping a clinician draft a referral letter to a specialist. The chart is synthetic teaching data.\\n\\nRules:\\n- Use only the chart text provided. Never invent findings, doses, dates or history.\\n- If the letter needs something that is not in the chart, write \\\"Not documented\\\" in its place.\\n- Use plain, professional language. Keep the letter to one page.\\n- Use these headings: Patient, Reason for referral, Relevant history, Current medications, Allergies, Pertinent results, Question for the specialist, Urgency.\\n- The reason for referral is the clinician's reason if one is given; otherwise say what the encounter shows and that no reason was given.\\n- Mention anything in the chart that looks inconsistent or unsafe, so the specialist knows.\\n- End with the line \\\"Draft for clinician review. Not sent.\\\" and a signature line \\\"[Referring clinician]\\\".\";\n\nreturn [{ json: {\n  request: { model: $env.AI_MODEL || 'gpt-5.3-codex', instructions, input, store: false },\n  sees: { system: instructions, user: input },\n} }];\n"
      },
